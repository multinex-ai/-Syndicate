#!/bin/bash
set -euo pipefail
AGENT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
export LOCAL_AGENTS_LOW_MEMORY=1
export LOCAL_AGENTS_TOLERATE_WARNING_GIB=2.0
export LOCAL_AGENTS_MIN_DISK_RESERVE_GIB="${LOCAL_AGENTS_MIN_DISK_RESERVE_GIB:-5.0}"
export LOCAL_AGENTS_ALLOW_LOCAL_FALLBACK="${LOCAL_AGENTS_ALLOW_LOCAL_FALLBACK:-0}"
export LOCAL_AGENTS_CONTEXT_SIZE="${LOCAL_AGENTS_CONTEXT_SIZE:-8192}"
export LOCAL_AGENTS_MAX_SWAP_GROWTH_GIB=3.0
exec "$AGENT_ROOT/bin/mnx" "$@"
