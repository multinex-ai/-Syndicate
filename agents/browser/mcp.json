{
  "schema_version": 1,
  "agent_id": "browser",
  "syndicate_id": "core-local-agents",
  "mcp_servers": [
    {
      "server_id": "memq_multinex",
      "enabled": true,
      "transport": "mcp_remote",
      "command_or_url": "https://mcp.multinex.ai/mcp/v1",
      "args": ["-y", "mcp-remote@latest", "https://mcp.multinex.ai/mcp/v1"],
      "env_keys": [],
      "allowed_tools": ["reunion", "namespace_info", "plan_state_read", "plan_state_write", "query_memory", "add_memory", "journal_record"],
      "description": "Sovereign MemQ continuity and verified checkpoint store (org:3f01ad9f)"
    },
    {
      "server_id": "local_agent_workers",
      "enabled": false,
      "transport": "stdio",
      "command_or_url": "shared/bin/run-mcp.sh",
      "args": [],
      "env_keys": [],
      "allowed_tools": ["local_agents_status", "start_local_agent", "local_agent_job", "cancel_local_agent", "local_agent_log"],
      "description": "Local Agent Workers & Syndicate Delegation Bridge"
    },
    {
      "server_id": "chrome_devtools",
      "enabled": true,
      "transport": "stdio",
      "command_or_url": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "env_keys": [],
      "allowed_tools": ["navigate_page", "take_snapshot", "take_screenshot"],
      "description": "Headless Chrome DevTools MCP for allowlisted OSINT & page inspection"
    }
  ]
}
